# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude/Cursor IDE files
.claude/

# GitHub workflows
.github/workflows/

# Screenshots
Screenshot*.png

# Allow logo/brand images
!public/images/bcv-*.png

# Global scripts symlink
scripts-global

# Draft files
DRAFT_*.md

# Integration docs (if temporary)
*_INTEGRATION_SETUP.md
GHL_INTEGRATION_SETUP.md

# Backup files
.env.local.backup*
*.backup-*
.env.local
logs/
.gstack/

# Shared ACT skills, synced from act-global-infrastructure (config/shared-skills.json,
# scripts/sync-skills.mjs). Tracked so the copy can be checked; edit upstream, not here.
!.claude/
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/act-brand-alignment/
!.claude/skills/_archive/
